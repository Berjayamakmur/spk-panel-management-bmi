function setupDatabase() {
  const ss=SpreadsheetApp.getActiveSpreadsheet();
  if(!ss) throw new Error("Buka Apps Script dari Google Spreadsheet melalui Extensions > Apps Script.");
  PropertiesService.getScriptProperties().setProperty("DB_ID",ss.getId());
  Object.keys(APP.SHEETS).forEach(k=>{
    let sh=ss.getSheetByName(APP.SHEETS[k]);
    if(!sh) sh=ss.insertSheet(APP.SHEETS[k]);
    const headers=APP.HEADERS[k];
    if(sh.getLastRow()===0){
      sh.getRange(1,1,1,headers.length).setValues([headers]);
      sh.setFrozenRows(1);
      sh.getRange(1,1,1,headers.length).setFontWeight("bold").setBackground("#173B68").setFontColor("#FFFFFF");
      sh.autoResizeColumns(1,headers.length);
    } else {
      const existing=sh.getRange(1,1,1,sh.getLastColumn()).getValues()[0].map(String);
      for(let i=0;i<Math.min(existing.length,headers.length);i++){
        if(existing[i]!==headers[i]) throw new Error("Header sheet "+APP.SHEETS[k]+" tidak sesuai kolom "+(i+1)+". Jangan menimpa database lama; periksa header.");
      }
      if(existing.length<headers.length){
        const missing=headers.slice(existing.length);
        sh.getRange(1,existing.length+1,1,missing.length).setValues([missing]).setFontWeight("bold").setBackground("#173B68").setFontColor("#FFFFFF");
        sh.autoResizeColumns(existing.length+1,missing.length);
      }
    }
  });
  ensureDriveFolder_();
  return {success:true,message:"Database V2 siap.",spreadsheetId:ss.getId()};
}

/** Jalankan sekali dengan kredensial yang diganti, lalu hapus helper ini. */
function buatAdminPertama(){
  setupAdmin("admin@berjaya.cloud","GANTI_PASSWORD_MINIMAL_12_KARAKTER","Administrator");
}

function setupAdmin(email,password,nama){
  const clean=normalizeEmail_(email);
  if(!clean||!nama||String(password||"").length<12) throw new Error("Email/nama wajib diisi dan password minimal 12 karakter.");
  const sh=db_().getSheetByName(APP.SHEETS.USERS);
  if(rows_(sh).some(x=>normalizeEmail_(x.email)===clean)) throw new Error("Email sudah terdaftar.");
  const salt=Utilities.getUuid().replace(/-/g,"")+Utilities.getUuid().replace(/-/g,"");
  const now=new Date().toISOString();
  sh.appendRow([Utilities.getUuid(),clean,hash_(String(password),salt),salt,String(nama),"Admin",true,now,now]);
  return "Admin dibuat: "+clean;
}

function loginUser(email,password){
  try{
    const clean=normalizeEmail_(email);
    const u=rows_(db_().getSheetByName(APP.SHEETS.USERS)).find(x=>normalizeEmail_(x.email)===clean);
    if(!u||!truth_(u.aktif)||!password||!constantEqual_(hash_(String(password),String(u.password_salt)),String(u.password_hash)))
      return {success:false,message:"Email/password salah atau akun tidak aktif."};
    const token=Utilities.getUuid()+Utilities.getUuid();
    const session={email:clean,nama:String(u.nama),role:String(u.role),issuedAt:Date.now()};
    CacheService.getScriptCache().put("sess_"+token,JSON.stringify(session),APP.SESSION_TTL);
    log_(clean,"LOGIN","Login berhasil","");
    return {success:true,message:"Login berhasil.",data:{...session,token}};
  }catch(e){return {success:false,message:e.message};}
}

function logoutUser(token){
  const u=session_(token);
  if(token) CacheService.getScriptCache().remove("sess_"+token);
  if(u) log_(u.email,"LOGOUT","Logout","");
  return {success:true};
}

function getInitialData(token){
  const u=auth_(token,APP.ROLES);
  return {success:true,user:u,dashboard:getDashboard(token).data,panel_types:panelTypes_()};
}

function createUser(token,data){
  const actor=auth_(token,["Admin"]); data=data||{};
  const email=normalizeEmail_(data.email), nama=String(data.nama||"").trim(), role=String(data.role||""), pass=String(data.password||"");
  if(!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) throw new Error("Email tidak valid.");
  if(!nama||!APP.ROLES.includes(role)||pass.length<12) throw new Error("Nama, role valid, dan password minimal 12 karakter wajib diisi.");
  const sh=db_().getSheetByName(APP.SHEETS.USERS);
  if(rows_(sh).some(x=>normalizeEmail_(x.email)===email)) throw new Error("Email sudah terdaftar.");
  const salt=Utilities.getUuid()+Utilities.getUuid(),now=new Date().toISOString();
  sh.appendRow([Utilities.getUuid(),email,hash_(pass,salt),salt,nama,role,true,now,now]);
  log_(actor.email,"CREATE_USER","Membuat akun "+email,"");
  return {success:true,message:"Pengguna dibuat."};
}

function listUsers(token){
  auth_(token,["Admin"]);
  return {success:true,data:rows_(db_().getSheetByName(APP.SHEETS.USERS)).map(x=>({id:x.id,email:x.email,nama:x.nama,role:x.role,aktif:truth_(x.aktif)}))};
}

function setUserActive(token,id,active){
  const actor=auth_(token,["Admin"]), sh=db_().getSheetByName(APP.SHEETS.USERS), f=find_(sh,id);
  if(!f) throw new Error("Pengguna tidak ditemukan.");
  if(normalizeEmail_(f.obj.email)===actor.email&&!active) throw new Error("Tidak dapat menonaktifkan akun sendiri.");
  sh.getRange(f.row,7).setValue(Boolean(active)); sh.getRange(f.row,9).setValue(new Date().toISOString());
  log_(actor.email,"UPDATE_USER","Status akun "+f.obj.email+" menjadi "+(active?"aktif":"nonaktif"),"");
  return {success:true};
}

function getDashboard(token){
  auth_(token,APP.ROLES);
  const data=rows_(db_().getSheetByName(APP.SHEETS.SPK));
  const counts={"Belum Diproses":0,"Sedang Diproses":0,"Selesai":0};
  data.forEach(x=>{if(counts[x.status_produksi]!==undefined)counts[x.status_produksi]++;});
  const month={}; const now=new Date();
  for(let i=11;i>=0;i--){const d=new Date(now.getFullYear(),now.getMonth()-i,1);month[Utilities.formatDate(d,Session.getScriptTimeZone(),"yyyy-MM")]=0;}
  data.forEach(x=>{const d=parseDate_(x.tanggal_spk);if(d){const k=Utilities.formatDate(d,Session.getScriptTimeZone(),"yyyy-MM");if(month[k]!==undefined)month[k]++;}});
  const latest=data.slice().sort((a,b)=>String(b.created_at).localeCompare(String(a.created_at))).slice(0,5);
  return {success:true,data:{
    total_spk_aktif:data.filter(x=>x.status_produksi!=="Selesai").length,
    total_unit:data.reduce((n,x)=>n+(Number(x.jumlah_unit)||0),0),
    grafik_bulanan:Object.keys(month).map(k=>({bulan:k,jumlah:month[k]})),
    spk_terbaru:latest.map(publicSpk_),
    status_counts:{belum_diproses:counts["Belum Diproses"],sedang_diproses:counts["Sedang Diproses"],selesai:counts["Selesai"]}
  }};
}

function getAllSpk(token,filters){
  auth_(token,APP.ROLES); filters=filters||{};
  const start=String(filters.tanggal_mulai||""),end=String(filters.tanggal_akhir||"");
  const customer=String(filters.nama_pelanggan||"").toLowerCase().trim(),type=String(filters.jenis_panel||"").toLowerCase().trim(),search=String(filters.search_text||"").toLowerCase().trim();
  const data=rows_(db_().getSheetByName(APP.SHEETS.SPK)).filter(x=>{
    const d=dateString_(x.tanggal_spk);
    return (!start||d>=start)&&(!end||d<=end)&&(!customer||String(x.nama_pelanggan).toLowerCase().includes(customer))&&(!type||String(x.jenis_panel).toLowerCase()===type)&&(!search||(String(x.no_spk).toLowerCase().includes(search)||String(x.nama_project).toLowerCase().includes(search)));
  }).sort((a,b)=>dateString_(b.tanggal_spk).localeCompare(dateString_(a.tanggal_spk)));
  return {success:true,data:data.map(publicSpk_)};
}

function createSpk(token,data){
  const u=auth_(token,APP.ROLES),d=validateSpkHeader_(data),items=validateItems_(data.items);
  const lock=LockService.getScriptLock();lock.waitLock(20000);
  try{
    const sh=db_().getSheetByName(APP.SHEETS.SPK);
    if(rows_(sh).some(x=>String(x.no_spk).toLowerCase()===d.no_spk.toLowerCase()))throw new Error("Nomor SPK sudah digunakan.");
    const id=Utilities.getUuid(),now=new Date().toISOString(),total=items.reduce((n,x)=>n+x.jumlah_unit,0);
    sh.appendRow([id,now,d.no_spk,d.tanggal_spk,d.nama_pelanggan,d.nama_project,items.map(x=>x.nama_panel).join(", "),d.keterangan,total,"Belum Diproses",now,u.email,u.email,d.lokasi_proyek]);
    saveItems_(id,items,now);
    statusHistory_(id,"Belum Diproses",u.email,"SPK dibuat");log_(u.email,"CREATE_SPK","Membuat SPK "+d.no_spk+" ("+items.length+" item panel)",id);
    return {success:true,message:"SPK berhasil dibuat.",data:{id}};
  }finally{lock.releaseLock();}
}
function updateSpk(token,id,data){
  const u=auth_(token,APP.ROLES),sh=db_().getSheetByName(APP.SHEETS.SPK),f=find_(sh,id);
  if(!f)throw new Error("SPK tidak ditemukan.");
  const old=f.obj;data=data||{};
  const d=validateSpkHeader_({no_spk:data.no_spk??old.no_spk,tanggal_spk:data.tanggal_spk??old.tanggal_spk,nama_pelanggan:data.nama_pelanggan??old.nama_pelanggan,nama_project:data.nama_project??old.nama_project,lokasi_proyek:data.lokasi_proyek??old.lokasi_proyek,keterangan:data.keterangan??old.keterangan});
  const items=data.items!==undefined?validateItems_(data.items):itemsFor_(id,old);
  const status=data.status_produksi!==undefined?String(data.status_produksi):String(old.status_produksi);
  if(!APP.STATUS.includes(status))throw new Error("Status tidak valid.");
  if(APP.STATUS.indexOf(status)<APP.STATUS.indexOf(String(old.status_produksi)))throw new Error("Status hanya boleh maju.");
  const lock=LockService.getScriptLock();lock.waitLock(20000);
  try{
    if(rows_(sh).some(x=>x.id!==id&&String(x.no_spk).toLowerCase()===d.no_spk.toLowerCase()))throw new Error("Nomor SPK sudah digunakan.");
    const now=new Date().toISOString(),total=items.reduce((n,x)=>n+x.jumlah_unit,0);
    // Write new item rows first. On an unexpected partial failure, restore from backup.
    const ish=db_().getSheetByName(APP.SHEETS.ITEMS),oldItems=rows_(ish).filter(x=>String(x.spk_id)===String(id));
    try{replaceItems_(id,items,now);}catch(err){try{replaceItems_(id,oldItems.map(x=>({nama_panel:x.nama_panel,jumlah_unit:Number(x.jumlah_unit),spesifikasi:x.spesifikasi})),now);}catch(ignore){}throw err;}
    sh.getRange(f.row,1,1,APP.HEADERS.SPK.length).setValues([[old.id,old.created_at,d.no_spk,d.tanggal_spk,d.nama_pelanggan,d.nama_project,items.map(x=>x.nama_panel).join(", "),d.keterangan,total,status,now,old.created_by||u.email,u.email,d.lokasi_proyek]]);
    if(status!==old.status_produksi){statusHistory_(id,status,u.email,"Status diubah dari "+old.status_produksi+" menjadi "+status);log_(u.email,"CHANGE_STATUS",d.no_spk+": "+old.status_produksi+" → "+status,id);}
    else log_(u.email,"UPDATE_SPK","Memperbarui SPK "+d.no_spk+" dan "+items.length+" item panel",id);
    return {success:true,message:"SPK diperbarui."};
  }finally{lock.releaseLock();}
}
function deleteSpk(token,id){
  const u=auth_(token,["Admin"]),sh=db_().getSheetByName(APP.SHEETS.SPK),f=find_(sh,id);
  if(!f)throw new Error("SPK tidak ditemukan.");
  // Keep audit/photo metadata; remove main record only. Photos remain in Drive for audit.
  sh.deleteRow(f.row);log_(u.email,"DELETE_SPK","Menghapus SPK "+f.obj.no_spk,id);
  return {success:true,message:"SPK dihapus. Metadata foto dipertahankan sebagai arsip."};
}

