/* ---------------- V2: REPORTS ---------------- */

function getProductionReport(token,filters){
  auth_(token,APP.ROLES);filters=filters||{};
  const start=String(filters.tanggal_mulai||""),end=String(filters.tanggal_akhir||""),status=String(filters.status_produksi||"");
  const data=rows_(db_().getSheetByName(APP.SHEETS.SPK)).filter(x=>{
    const d=dateString_(x.tanggal_spk);
    return (!start||d>=start)&&(!end||d<=end)&&(!status||x.status_produksi===status);
  }).sort((a,b)=>dateString_(b.tanggal_spk).localeCompare(dateString_(a.tanggal_spk)));
  const unit=data.reduce((n,x)=>n+(Number(x.jumlah_unit)||0),0);
  const counts={"Belum Diproses":0,"Sedang Diproses":0,"Selesai":0};
  data.forEach(x=>{if(counts[x.status_produksi]!==undefined)counts[x.status_produksi]++;});
  return {success:true,data:{rows:data.map(publicSpk_),summary:{total_spk:data.length,total_unit:unit,status_counts:counts}}};
}

function exportProductionCsv(token,filters){
  const u=auth_(token,APP.ROLES),r=getProductionReport(token,filters).data;
  const header=["No SPK","Tanggal","Pelanggan","Project","Lokasi Proyek","Jenis Panel","Keterangan","Jumlah Unit","Status Produksi"];
  const lines=[header].concat(r.rows.map(x=>[x.no_spk,x.tanggal_spk,x.nama_pelanggan,x.nama_project,x.lokasi_proyek,x.jenis_panel,x.keterangan,x.jumlah_unit,x.status_produksi]));
  const csv="\uFEFF"+lines.map(row=>row.map(csvCell_).join(",")).join("\r\n");
  const file=ensureDriveFolder_().createFile(Utilities.newBlob(csv,"text/csv","Laporan_Produksi_"+Utilities.formatDate(new Date(),Session.getScriptTimeZone(),"yyyyMMdd_HHmm")+".csv"));
  log_(u.email,"EXPORT_REPORT_CSV","Ekspor laporan produksi CSV","");
  return {success:true,data:{file_name:file.getName(),url:file.getUrl()}};
}

function exportProductionPdf(token,filters){
  const u=auth_(token,APP.ROLES),r=getProductionReport(token,filters).data;
  const logoData = "data:image/jpeg;base64,";
  const body=r.rows.map(x=>`<tr><td>${escapeHtml_(x.no_spk)}</td><td>${escapeHtml_(x.tanggal_spk)}</td><td>${escapeHtml_(x.nama_pelanggan)}</td><td>${escapeHtml_(x.nama_project)}</td><td>${escapeHtml_(x.lokasi_proyek)}</td><td>${escapeHtml_(x.jenis_panel)}</td><td>${x.jumlah_unit}</td><td>${escapeHtml_(x.status_produksi)}</td></tr>`).join("");
  const html=`<html><head><meta charset="utf-8"><style>body{font:9px Arial;margin:25px;color:#172033}.logo{display:block;width:250px;max-width:75%;height:auto;margin:0 auto 8px}h1{color:#173b68;font-size:16px}p{font-size:9px}table{width:100%;border-collapse:collapse}th,td{border:1px solid #ccd4df;padding:6px;text-align:left}th{background:#eaf0f7}</style></head><body><img class="logo" src="${logoData}" alt="Logo BMI"><p style="text-align:center">${escapeHtml_(APP.COMPANY.address)} | ${escapeHtml_(APP.COMPANY.phone)}</p><h2>LAPORAN PROGRES PRODUKSI PANEL</h2><p>Periode: ${escapeHtml_(filters&&filters.tanggal_mulai||"Semua")} s.d. ${escapeHtml_(filters&&filters.tanggal_akhir||"Semua")} | Total SPK: ${r.summary.total_spk} | Total Unit: ${r.summary.total_unit}</p><table><tr><th>No SPK</th><th>Tanggal</th><th>Pelanggan</th><th>Project</th><th>Lokasi Proyek</th><th>Jenis Panel</th><th>Unit</th><th>Status</th></tr>${body}</table></body></html>`;
  const blob=HtmlService.createHtmlOutput(html).getBlob().setName("Laporan_Progres_Panel.pdf").getAs(MimeType.PDF);
  const file=ensureDriveFolder_().createFile(blob);
  log_(u.email,"EXPORT_REPORT_PDF","Ekspor laporan produksi PDF","");
  return {success:true,data:{file_name:file.getName(),url:file.getUrl()}};
}

/* ---------------- Helpers ---------------- */

function db_(){const id=PropertiesService.getScriptProperties().getProperty("DB_ID");if(!id)throw new Error("Database belum disiapkan. Jalankan setupDatabase().");return SpreadsheetApp.openById(id);}
function rows_(sh){if(!sh||sh.getLastRow()<2)return [];const a=sh.getDataRange().getValues(),h=a.shift().map(String);return a.filter(r=>r.some(v=>v!=="")).map(r=>{const o={};h.forEach((k,i)=>o[k]=r[i] instanceof Date?r[i].toISOString():r[i]);return o;});}
function find_(sh,id){if(!sh||sh.getLastRow()<2)return null;const vals=sh.getRange(2,1,sh.getLastRow()-1,1).getValues();for(let i=0;i<vals.length;i++)if(String(vals[i][0])===String(id)){const h=sh.getRange(1,1,1,sh.getLastColumn()).getValues()[0].map(String),v=sh.getRange(i+2,1,1,h.length).getValues()[0],o={};h.forEach((k,j)=>o[k]=v[j] instanceof Date?v[j].toISOString():v[j]);return {row:i+2,obj:o};}return null;}
function session_(token){if(!token)return null;const s=CacheService.getScriptCache().get("sess_"+token);try{return s?JSON.parse(s):null;}catch(e){return null;}}
function auth_(token,roles){const u=session_(token);if(!u)throw new Error("Sesi berakhir. Silakan login kembali.");if(!roles.includes(u.role))throw new Error("Akses ditolak.");return u;}
function normalizeEmail_(v){return String(v||"").trim().toLowerCase();}
function truth_(v){return v===true||String(v).toLowerCase()==="true";}
function hash_(p,s){let v=s+"|"+p;for(let i=0;i<APP.HASH_ROUNDS;i++)v=Utilities.base64Encode(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,v,Utilities.Charset.UTF_8));return v;}
function constantEqual_(a,b){if(a.length!==b.length)return false;let d=0;for(let i=0;i<a.length;i++)d|=a.charCodeAt(i)^b.charCodeAt(i);return d===0;}
function validateSpk_(x){x=x||{};const d={no_spk:String(x.no_spk||"").trim(),tanggal_spk:dateString_(x.tanggal_spk),nama_pelanggan:String(x.nama_pelanggan||"").trim(),nama_project:String(x.nama_project||"").trim(),jenis_panel:String(x.jenis_panel||"").trim(),keterangan:String(x.keterangan||"").trim(),jumlah_unit:Number(x.jumlah_unit)};if(!d.no_spk||d.no_spk.length>80)throw new Error("Nomor SPK wajib diisi (maks. 80 karakter).");if(!/^\d{4}-\d{2}-\d{2}$/.test(d.tanggal_spk))throw new Error("Tanggal SPK tidak valid.");if(!d.nama_pelanggan||!d.nama_project||!d.jenis_panel)throw new Error("Pelanggan, project, dan jenis panel wajib diisi.");if(!Number.isInteger(d.jumlah_unit)||d.jumlah_unit<1)throw new Error("Jumlah unit harus bilangan bulat minimal 1.");if(d.keterangan.length>5000)throw new Error("Keterangan maksimal 5.000 karakter.");return d;}
function publicSpk_(x){return {id:String(x.id),no_spk:String(x.no_spk),tanggal_spk:dateString_(x.tanggal_spk),nama_pelanggan:String(x.nama_pelanggan),nama_project:String(x.nama_project),lokasi_proyek:String(x.lokasi_proyek||""),jenis_panel:String(x.jenis_panel),keterangan:String(x.keterangan||""),jumlah_unit:Number(x.jumlah_unit)||0,status_produksi:String(x.status_produksi),created_at:String(x.created_at),updated_at:String(x.updated_at)};}
function dateString_(v){if(v instanceof Date)return Utilities.formatDate(v,Session.getScriptTimeZone(),"yyyy-MM-dd");const s=String(v||"").trim();if(/^\d{4}-\d{2}-\d{2}$/.test(s))return s;const d=new Date(s);return isNaN(d)? "":Utilities.formatDate(d,Session.getScriptTimeZone(),"yyyy-MM-dd");}
function parseDate_(v){const s=dateString_(v);if(!s)return null;const p=s.split("-").map(Number);return new Date(p[0],p[1]-1,p[2]);}
function statusHistory_(id,status,email,note){db_().getSheetByName(APP.SHEETS.HISTORY).appendRow([Utilities.getUuid(),id,status,new Date().toISOString(),email,note||""]);}
function log_(email,action,detail,id){db_().getSheetByName(APP.SHEETS.LOG).appendRow([Utilities.getUuid(),new Date().toISOString(),email,action,detail,id||""]);}
function panelTypes_(){const a=[...new Set(rows_(db_().getSheetByName(APP.SHEETS.SPK)).map(x=>String(x.jenis_panel||"").trim()).filter(Boolean))];return a.length?a:["Panel Booster Pump VSD","Panel LDB Distribution","Panel ATS-AMF Generator","Panel Electric Fire Pump","Panel Chiller Pump","Panel Control"];}
function ensureDriveFolder_(){const props=PropertiesService.getScriptProperties();let id=props.getProperty("DRIVE_FOLDER_ID");if(id){try{return DriveApp.getFolderById(id);}catch(e){}}const folder=DriveApp.createFolder("SPK Panel BMI - Dokumen dan Foto Produksi");props.setProperty("DRIVE_FOLDER_ID",folder.getId());return folder;}
function escapeHtml_(v){return String(v==null?"":v).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));}
function safeFile_(v){return String(v||"SPK").replace(/[^\w.-]/g,"_").slice(0,80);}
function csvCell_(v){let s=String(v==null?"":v);if(/^[=+\-@]/.test(s))s="'"+s;return '"'+s.replace(/"/g,'""')+'"';}

/* -------- V2.1: one SPK header, multiple panel items -------- */
function validateSpkHeader_(x){
  x=x||{};const d={no_spk:String(x.no_spk||"").trim(),tanggal_spk:dateString_(x.tanggal_spk),nama_pelanggan:String(x.nama_pelanggan||"").trim(),nama_project:String(x.nama_project||"").trim(),lokasi_proyek:String(x.lokasi_proyek||"").trim(),keterangan:String(x.keterangan||"").trim()};
  if(!d.no_spk||d.no_spk.length>80)throw new Error("Nomor SPK wajib diisi (maks. 80 karakter).");
  if(!/^\d{4}-\d{2}-\d{2}$/.test(d.tanggal_spk))throw new Error("Tanggal SPK tidak valid.");
  if(!d.nama_pelanggan||!d.nama_project)throw new Error("Pelanggan dan project wajib diisi.");
  if(!d.lokasi_proyek||d.lokasi_proyek.length>250)throw new Error("Lokasi proyek wajib diisi (maks. 250 karakter).");
  if(d.keterangan.length>5000)throw new Error("Keterangan SPK maksimal 5.000 karakter.");
  return d;
}
function validateItems_(items){
  if(!Array.isArray(items)||!items.length||items.length>100)throw new Error("SPK harus memiliki 1 sampai 100 item panel.");
  return items.map((x,i)=>{const nama_panel=String(x.nama_panel||"").trim(),jumlah_unit=Number(x.jumlah_unit),spesifikasi=String(x.spesifikasi||"").trim();
    if(!nama_panel||nama_panel.length>150)throw new Error("Nama panel item "+(i+1)+" wajib diisi (maks. 150 karakter).");
    if(!Number.isInteger(jumlah_unit)||jumlah_unit<1||jumlah_unit>100000)throw new Error("Jumlah unit item "+(i+1)+" tidak valid.");
    if(spesifikasi.length>5000)throw new Error("Spesifikasi item "+(i+1)+" maksimal 5.000 karakter.");
    return {nama_panel,jumlah_unit,spesifikasi};
  });
}
function itemsFor_(id,legacy){
  const arr=rows_(db_().getSheetByName(APP.SHEETS.ITEMS)).filter(x=>String(x.spk_id)===String(id)).sort((a,b)=>Number(a.urutan)-Number(b.urutan)).map(x=>({id:x.id,nama_panel:String(x.nama_panel),jumlah_unit:Number(x.jumlah_unit),spesifikasi:String(x.spesifikasi||"")}));
  if(arr.length)return arr;
  // Read-only compatibility for V2 SPK rows not yet migrated to SPKItems.
  return legacy&&legacy.jenis_panel?[{nama_panel:String(legacy.jenis_panel),jumlah_unit:Number(legacy.jumlah_unit)||1,spesifikasi:String(legacy.keterangan||"")}]:[];
}
function saveItems_(id,items,now){const sh=db_().getSheetByName(APP.SHEETS.ITEMS);items.forEach((x,i)=>sh.appendRow([Utilities.getUuid(),id,i+1,x.nama_panel,x.jumlah_unit,x.spesifikasi,now,now]));}
function replaceItems_(id,items,now){const sh=db_().getSheetByName(APP.SHEETS.ITEMS),r=rows_(sh);for(let i=r.length-1;i>=0;i--)if(String(r[i].spk_id)===String(id))sh.deleteRow(i+2);saveItems_(id,items,now);}
