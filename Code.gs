/* ---------------- V2: PHOTO DOCUMENTATION ---------------- */

function uploadSpkPhoto(token,payload){
  const u=auth_(token,APP.ROLES);payload=payload||{};
  const f=find_(db_().getSheetByName(APP.SHEETS.SPK),payload.spk_id);
  if(!f)throw new Error("SPK tidak ditemukan.");
  const mime=String(payload.mime_type||"");
  if(!/^image\/(jpeg|png|webp)$/.test(mime))throw new Error("Format foto harus JPG, PNG, atau WEBP.");
  const bytes=Utilities.base64Decode(String(payload.base64||""));
  if(!bytes.length||bytes.length>APP.PHOTO_MAX_BYTES)throw new Error("Ukuran foto kosong atau melebihi 5 MB.");
  const folder=ensureDriveFolder_();
  const safeName=String(payload.file_name||"foto-produksi").replace(/[^\w.-]/g,"_").slice(0,100);
  const blob=Utilities.newBlob(bytes,mime,safeName);
  const file=folder.createFile(blob);
  // Files are private by default; access follows Drive permissions of the owner.
  const now=new Date().toISOString(),id=Utilities.getUuid();
  db_().getSheetByName(APP.SHEETS.PHOTOS).appendRow([id,payload.spk_id,file.getId(),file.getName(),mime,file.getUrl(),String(payload.kategori||"Progres"),String(payload.keterangan||"").slice(0,1000),now,u.email]);
  log_(u.email,"UPLOAD_PHOTO","Upload foto "+file.getName()+" untuk SPK "+f.obj.no_spk,payload.spk_id);
  return {success:true,message:"Foto berhasil disimpan di Google Drive.",data:{id,file_name:file.getName(),drive_url:file.getUrl(),uploaded_at:now}};
}

function getSpkPhotos(token,spkId){
  auth_(token,APP.ROLES);
  const list=rows_(db_().getSheetByName(APP.SHEETS.PHOTOS)).filter(x=>x.spk_id===spkId).sort((a,b)=>String(b.uploaded_at).localeCompare(String(a.uploaded_at)));
  return {success:true,data:list.map(x=>({id:x.id,file_id:x.file_id,file_name:x.file_name,mime_type:x.mime_type,drive_url:x.drive_url,kategori:x.kategori,keterangan:x.keterangan,uploaded_at:x.uploaded_at,uploaded_by:x.uploaded_by}))};
}

